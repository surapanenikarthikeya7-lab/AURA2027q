# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional SMTP configuration for live order confirmation & cancellation emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Aura <orders@example.com>"

# Optional Resend API key for transactional email delivery
RESEND_API_KEY=""

# Optional server encryption key for stored mail credentials
ADMIN_SECRET_KEY=""
